# Seven variables out of one INPUT/atm.nc, the shape ackbar's forcing archive
# normalizes every source into. Read when a forcing layer is inherited; the
# base data_table beside this one is the same table, because HAT10 has no
# climatological fallback staged and the cold start needs a real atmosphere.
#
# z_bot = 10.0 with T2/Q2 that are published at 2 m: the archive declares
# scalar_reference_height = 2.0, which ackbar reads and permits as a stated
# choice about a known bias (~10% on the turbulent fluxes). Declaring z_bot=2
# instead would mislabel the winds and cost 28-56% on the stress, which is
# worse. This reproduces HAT10's original soca-science configuration.
"ATM" , "p_surf"            , "SLP"   , "INPUT/atm.nc" , "bilinear" , 1.0
"ATM" , "p_bot"             , "SLP"   , "INPUT/atm.nc" , "bilinear" , 1.0
"ATM" , "t_bot"             , "T2"    , "INPUT/atm.nc" , "bilinear" , 1.0
"ATM" , "sphum_bot"         , "Q2"    , "INPUT/atm.nc" , "bilinear" , 1.0
"ATM" , "u_bot"             , "U10"   , "INPUT/atm.nc" , "bicubic"  , 1.0
"ATM" , "v_bot"             , "V10"   , "INPUT/atm.nc" , "bicubic"  , 1.0
"ATM" , "z_bot"             , ""      , ""             , "bilinear" , 10.0
"ATM" , "gust"              , ""      , ""             , "bilinear" , 1.0e-4
"ICE" , "lw_flux_dn"        , "DLWRF" , "INPUT/atm.nc" , "bilinear" , 1.0
"ICE" , "sw_flux_vis_dir_dn", "DSWRF" , "INPUT/atm.nc" , "bilinear" , 0.285
"ICE" , "sw_flux_vis_dif_dn", "DSWRF" , "INPUT/atm.nc" , "bilinear" , 0.285
"ICE" , "sw_flux_nir_dir_dn", "DSWRF" , "INPUT/atm.nc" , "bilinear" , 0.215
"ICE" , "sw_flux_nir_dif_dn", "DSWRF" , "INPUT/atm.nc" , "bilinear" , 0.215
"ICE" , "lprec"             , "PRATE" , "INPUT/atm.nc" , "bilinear" , 1.0
"ICE" , "fprec"             , ""      , ""             , "none" , 0.0
"ICE" , "runoff"            , ""      , ""             , "none" , 0.0
"ICE" , "calving"           , ""      , ""             , "none" , 0.0
"ICE" , "dhdt"              , ""      , ""             , "none" , 80.0
"ICE" , "dedt"              , ""      , ""             , "none" , 2.0e-6
"ICE" , "drdt"              , ""      , ""             , "none" , 10.0
"LND" , "t_surf"            , ""      , ""             , "none" , 273.0
"LND" , "t_ca"              , ""      , ""             , "none" , 273.0
"LND" , "q_ca"              , ""      , ""             , "none" , 0.0
"LND" , "rough_mom"         , ""      , ""             , "none" , 0.01
"LND" , "rough_heat"        , ""      , ""             , "none" , 0.1
"LND" , "albedo"            , ""      , ""             , "none" , 0.1
"LND" , "sphum_surf"        , ""      , ""             , "none" , 0.0
"LND" , "sphum_ca"          , ""      , ""             , "none" , 0.0
"LND" , "t_flux"            , ""      , ""             , "none" , 0.0
"LND" , "sphum_flux"        , ""      , ""             , "none" , 0.0
"LND" , "lw_flux"           , ""      , ""             , "none" , 0.0
"LND" , "sw_flux"           , ""      , ""             , "none" , 0.0
"LND" , "lprec"             , ""      , ""             , "none" , 0.0
"LND" , "fprec"             , ""      , ""             , "none" , 0.0
"LND" , "dhdt"              , ""      , ""             , "none" , 5.0
"LND" , "dedt"              , ""      , ""             , "none" , 2e-6
"LND" , "dedq"              , ""      , ""             , "none" , 0.0
"LND" , "drdt"              , ""      , ""             , "none" , 5.0
"LND" , "drag_q"            , ""      , ""             , "none" , 0.0
"LND" , "p_surf"            , ""      , ""             , "none" , 1.e5
